# Real F18 on the LAN, mock Atlas — for testing actual hardware before the
# Atlas API implements the four endpoints in atlas_client.py (auth/login,
# auth/refresh, attendance-events, schools/{id}/card-assignments). Copy to
# `.env`, set F18_HOST, then:
#   python -m atlas_edge.web        (terminal 1)
#   python -m atlas_edge.listener   (terminal 2)
# http://localhost:8080 — any email/password signs in (Atlas is mocked).
#
# Once Atlas has those endpoints, switch ATLAS_DRIVER to `http` and point
# ATLAS_BASE_URL at it — nothing else changes.

ATLAS_EDGE_DEVICE_DRIVER=f18
ATLAS_EDGE_ATLAS_DRIVER=mock

ATLAS_EDGE_F18_HOST=192.168.1.254          # <-- the F18's real LAN IP
ATLAS_EDGE_F18_PORT=4370
ATLAS_EDGE_F18_PASSWORD=0
ATLAS_EDGE_F18_TIMEOUT=10

ATLAS_EDGE_SCHOOL_ID=demo-school
ATLAS_EDGE_DEVICE_ID=edge-dev-laptop
ATLAS_EDGE_DB_PATH=./data/atlas_edge.sqlite3

ATLAS_EDGE_WEB_HOST=127.0.0.1
ATLAS_EDGE_WEB_PORT=8080
ATLAS_EDGE_WEB_SECRET_KEY=local-dev-only-not-secret

ATLAS_EDGE_MOCK_CARD_ASSIGNMENTS_PATH=./data/mock_card_assignments.json
ATLAS_EDGE_MOCK_ATLAS_FAIL_RATE=0.0

# Real-hardware pacing — no need to hammer the terminal on a laptop demo.
ATLAS_EDGE_FLUSH_INTERVAL_SECONDS=15
ATLAS_EDGE_HOUSEKEEPING_TICK_SECONDS=10
ATLAS_EDGE_RECONCILE_INTERVAL_SECONDS=1800

ATLAS_EDGE_LOG_LEVEL=INFO
