[Unit]
Description=Atlas-Edge — F18 tap listener & device owner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=limitify
Group=limitify
WorkingDirectory=/home/limitify/Developer/Atlas-Edge
EnvironmentFile=/home/limitify/Developer/Atlas-Edge/.env
ExecStart=/home/limitify/Developer/Atlas-Edge/venv/bin/python -m atlas_edge.listener
Restart=always
RestartSec=5
# Give the F18/network a moment on boot before the first connect attempt.
ExecStartPre=/bin/sleep 5

# Light hardening only — ProtectHome is deliberately NOT set: the whole
# deployment (code, venv, .env, data/) lives under /home/limitify, which
# that directive would make inaccessible to the service entirely.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/limitify/Developer/Atlas-Edge/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
