[Unit]
Description=Atlas-Edge — hostapd for the ap0 admin hotspot
# Deliberately no After=/BindsTo=atlas-ap0-setup.service: that unit's own
# ExecStart is what calls `systemctl restart` on this one, and since it's a
# oneshot that isn't "active" until its script returns, any ordering
# dependency back on it deadlocks (this unit waits for setup to be active;
# setup waits for its script, which is waiting for this unit to start).

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /etc/hostapd/atlas-ap0.conf
Restart=on-failure
RestartSec=5

# Not enabled/started directly — atlas-ap0-setup.service (re)starts this
# once ap0 exists and /etc/hostapd/atlas-ap0.conf has been written. Not
# sandboxed like atlas-edge-web/listener: driving the radio via nl80211
# needs root.
