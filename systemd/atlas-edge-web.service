[Unit]
Description=Atlas-Edge — technician web UI
After=network-online.target atlas-edge-listener.service
Wants=network-online.target
# The web UI works without the listener, but enrollment jobs it queues only run
# while the listener is up. Not a hard dependency on purpose: a crashed listener
# must not take the UI down, and vice versa.

[Service]
Type=simple
User=atlas-edge
Group=atlas-edge
WorkingDirectory=/opt/atlas-edge
EnvironmentFile=/opt/atlas-edge/.env
ExecStart=/opt/atlas-edge/.venv/bin/python -m atlas_edge.web
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/atlas-edge/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
