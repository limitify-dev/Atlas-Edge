# Copy to `.env` and edit. Every setting is optional except where noted.
# Point at a different F18 or Atlas environment by editing this file only.
# For a no-hardware laptop run, use `.env.local.example` instead.

# ── Drivers ────────────────────────────────────────────────────────────
# f18 | mock | auto   (auto -> mock when F18_HOST is "mock"/empty)
ATLAS_EDGE_DEVICE_DRIVER=auto
# http | mock | auto  (auto -> mock when ATLAS_BASE_URL is empty/contains "mock")
ATLAS_EDGE_ATLAS_DRIVER=auto

# ── ZKTeco F18 terminal ────────────────────────────────────────────────
ATLAS_EDGE_F18_HOST=192.168.1.254        # REQUIRED: the F18's LAN IP
ATLAS_EDGE_F18_PORT=4370
ATLAS_EDGE_F18_PASSWORD=0                 # device comm key (usually 0)
ATLAS_EDGE_F18_TIMEOUT=15
ATLAS_EDGE_F18_FORCE_UDP=false
# Set only if the Pi's clock/timezone doesn't match the school (IANA name):
ATLAS_EDGE_DEVICE_TIMEZONE=

# ── Atlas API ──────────────────────────────────────────────────────────
ATLAS_EDGE_ATLAS_BASE_URL=https://api.atlas.example   # REQUIRED, no trailing slash
ATLAS_EDGE_ATLAS_API_PREFIX=/api/v1
ATLAS_EDGE_HTTP_TIMEOUT_SECONDS=20

# ── This gateway / school identity ─────────────────────────────────────
ATLAS_EDGE_SCHOOL_ID=REPLACE_WITH_SCHOOL_ID     # REQUIRED
ATLAS_EDGE_DEVICE_ID=edge-pi-01                 # stable id for this Pi

# ── Local state ────────────────────────────────────────────────────────
ATLAS_EDGE_DB_PATH=./data/atlas_edge.sqlite3

# ── Web UI ─────────────────────────────────────────────────────────────
ATLAS_EDGE_WEB_HOST=0.0.0.0
ATLAS_EDGE_WEB_PORT=8080
# REQUIRED in production. Generate:  openssl rand -hex 32
ATLAS_EDGE_WEB_SECRET_KEY=change-me-please
ATLAS_EDGE_SESSION_MAX_AGE_SECONDS=43200

# ── Timers (seconds) — sensible defaults, tune if needed ───────────────
ATLAS_EDGE_FLUSH_INTERVAL_SECONDS=15
ATLAS_EDGE_RECONCILE_INTERVAL_SECONDS=3600
ATLAS_EDGE_HOUSEKEEPING_TICK_SECONDS=10
ATLAS_EDGE_RECONNECT_BACKOFF_START_SECONDS=3
ATLAS_EDGE_RECONNECT_BACKOFF_MAX_SECONDS=60
ATLAS_EDGE_PUSH_BACKOFF_MAX_SECONDS=900
ATLAS_EDGE_NAME_MAP_REFRESH_SECONDS=300

ATLAS_EDGE_LOG_LEVEL=INFO

# ── WiFi admin hotspot (Pi only — atlas_edge/scripts/ap0_*.sh) ──────────
# ap0 rides on top of the station WiFi radio so the Pi is always reachable
# locally for admin/recovery, even while connected to the school network.
# Driven directly by hostapd + dnsmasq (NOT via NetworkManager/nmcli — its
# hotspot activation doesn't work on this radio, see ap0_setup.sh).
# ATLAS_EDGE_WIFI_IFACE is also read by the Python app itself (config.py) —
# it's what the /wifi-setup admin page drives via nmcli. Everything else
# here is shell-script-only, via EnvironmentFile=.
ATLAS_EDGE_WIFI_IFACE=wlan0                  # the station radio (USB adapter)
ATLAS_EDGE_HOTSPOT_IFACE=ap0                 # virtual AP interface, created on top of it
ATLAS_EDGE_WIFI_ASSOC_TIMEOUT_SECONDS=60     # how long to wait for wlan0 to associate at boot
ATLAS_EDGE_HOTSPOT_SSID=REPLACE_ME           # REQUIRED
ATLAS_EDGE_HOTSPOT_PASSWORD=REPLACE_ME       # REQUIRED, WPA2, 8-63 chars
ATLAS_EDGE_HOTSPOT_IP=10.42.0.1              # ap0's own address
ATLAS_EDGE_HOTSPOT_PREFIX=24
ATLAS_EDGE_HOTSPOT_DHCP_RANGE_START=10.42.0.10
ATLAS_EDGE_HOTSPOT_DHCP_RANGE_END=10.42.0.200
