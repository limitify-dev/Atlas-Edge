# Local test profile — no F18, no real Atlas. Copy to `.env` and run:
#   python -m atlas_edge.web        (terminal 1)
#   python -m atlas_edge.listener   (terminal 2)
# Then open http://localhost:8080 , sign in with any email/password,
# hit "Sync from Atlas", and use "Test tools" to simulate card taps.

ATLAS_EDGE_DEVICE_DRIVER=mock
ATLAS_EDGE_ATLAS_DRIVER=mock

ATLAS_EDGE_SCHOOL_ID=demo-school
ATLAS_EDGE_DEVICE_ID=edge-dev-laptop
ATLAS_EDGE_DB_PATH=./data/atlas_edge.sqlite3

ATLAS_EDGE_WEB_HOST=127.0.0.1
ATLAS_EDGE_WEB_PORT=8080
ATLAS_EDGE_WEB_SECRET_KEY=local-dev-only-not-secret

# The mock Atlas reads the card list from here:
ATLAS_EDGE_MOCK_CARD_ASSIGNMENTS_PATH=./data/mock_card_assignments.json
# Reject this fraction of event pushes so you can watch the retry/backoff work:
ATLAS_EDGE_MOCK_ATLAS_FAIL_RATE=0.0

# Snappier loops for a laptop demo:
ATLAS_EDGE_FLUSH_INTERVAL_SECONDS=3
ATLAS_EDGE_HOUSEKEEPING_TICK_SECONDS=3
ATLAS_EDGE_RECONCILE_INTERVAL_SECONDS=120

ATLAS_EDGE_LOG_LEVEL=INFO
